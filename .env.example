# Values below target the HOST (uv run …). docker-compose.yml overrides the two
# host names for the scraper container.

# ── Database — same Postgres as isos-api, least-privilege role ────────────────
# Start it from isos-api:  docker compose up -d db
# The password is ISOS_INGESTION_DB_PASSWORD in isos-api/.env.
ISOS_INGESTION_DB_PASSWORD=
POSTGRES_DB=isos_db
DATABASE_URL=postgresql+asyncpg://isos_ingestion:${ISOS_INGESTION_DB_PASSWORD}@localhost:5432/${POSTGRES_DB}

# ── Garage (S3) ───────────────────────────────────────────────────────────────
# Generate:  python -c "import secrets; print('GK'+secrets.token_hex(12)); print(secrets.token_hex(32))"
# then:      docker compose up -d garage && ./docker/garage/bootstrap.sh
S3_ENDPOINT=http://localhost:3900
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_RAW=isos-raw

# ── Assemblée nationale ───────────────────────────────────────────────────────
AN_BASE_URL=https://data.assemblee-nationale.fr
AN_LEGISLATURE=17

LOG_LEVEL=INFO
