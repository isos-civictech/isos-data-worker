# ── Database ──────────────────────────────────────────────────────────────────
# The worker connects to the SAME Postgres as isos-api, with the least-privilege
# role created by isos-api/docker/postgres/initdb/02_create_roles.sh:
#   isos_ingestion = owner of `raw`, INSERT/UPDATE on the content tables of
#   `public`, no DELETE anywhere, no access to user data.
#
# Start it from the isos-api repo:  docker compose up -d db
# The password is the ISOS_INGESTION_DB_PASSWORD of isos-api's .env.
#
# From inside docker compose (shared isos-network):
DATABASE_URL=postgresql+asyncpg://isos_ingestion:CHANGE_ME@db:5432/isos_db
# From the host, running the CLI directly:
# DATABASE_URL=postgresql+asyncpg://isos_ingestion:CHANGE_ME@localhost:5432/isos_db

# ── Garage (S3) ───────────────────────────────────────────────────────────────
# NOT placeholders to keep as-is: generate your own, then let
# `docker compose run --rm garage-bootstrap` import them into Garage.
#
#   S3_ACCESS_KEY :  "GK" + 24 hex chars
#   S3_SECRET_KEY :  64 hex chars
#
#   python -c "import secrets; print('GK'+secrets.token_hex(12)); print(secrets.token_hex(32))"
S3_ENDPOINT=http://garage:3900
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_RAW=isos-raw

# ── Assemblée nationale ───────────────────────────────────────────────────────
AN_BASE_URL=https://data.assemblee-nationale.fr
AN_LEGISLATURE=17

# ── Runtime ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
